# ==============================================================================
# Environment Variables Example for Mirai Softnet Company Profile
# Salin file ini menjadi .env sebelum menjalankan container atau development:
# cp .env.example .env
# ==============================================================================

# ==============================================================================
# 1. DATABASE CONFIGURATION (POSTGRESQL MANDIRI / SELF-HOSTED)
# ==============================================================================
# Opsi 1 (Recommended): Local dev via SSH tunnel ke database VPS
# Buka tunnel di terminal: ssh -N -L 5432:127.0.0.1:5432 root@your-vps-ip
DATABASE_URI=postgresql://postgres:your_password_here@127.0.0.1:5432/miraisoftnet_compro

# Opsi 2: Direct connection ke IP/Domain VPS (jika port 5432 dibuka di firewall VPS)
# DATABASE_URI=postgresql://postgres:your_password_here@your-vps-ip:5432/miraisoftnet_compro

# Opsi 3: Untuk Docker Compose di Server VPS (inter-container):
# DATABASE_URI=postgresql://postgres:your_password_here@postgres:5432/miraisoftnet_compro

# Kredensial Database Docker Container
POSTGRES_DB=miraisoftnet_compro
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# ==============================================================================
# 2. PAYLOAD CMS CONFIGURATION
# ==============================================================================
PAYLOAD_SECRET=your_32_characters_random_secret_string_here
PORT=3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ==============================================================================
# 3. STORAGE CONFIGURATION (NATIVE LOCAL STORAGE)
# ==============================================================================
STORAGE_DRIVER=local

# URL server VPS untuk fallback gambar jika file media belum ada di laptop saat dev
NEXT_PUBLIC_REMOTE_MEDIA_URL=https://miraisoftnet.com
